{
  "name": "twg-vscode",
  "displayName": "Atlassian Teamwork Graph CLI",
  "description": "Set up Atlassian Teamwork Graph CLI from an interactive VS Code terminal.",
  "version": "0.1.1",
  "publisher": "atlassian",
  "license": "SEE LICENSE IN LICENSE.txt",
  "homepage": "https://developer.atlassian.com/cloud/twg-cli/",
  "repository": {
    "type": "git",
    "url": "https://github.com/atlassian/twg-cli.git"
  },
  "bugs": {
    "url": "https://github.com/atlassian/twg-cli/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "atlassian",
    "teamwork graph",
    "twg",
    "jira",
    "confluence"
  ],
  "icon": "images/twg-logo.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "twg.setup",
        "title": "TWG: Set Up",
        "category": "Teamwork Graph"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "vscode:prepublish": "tsc -p tsconfig.json",
    "test": "pnpm run compile && node --test dist/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.0"
  }
}
